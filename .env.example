# --- Server ---
NODE_ENV=development            # production on Dokploy
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
# Comma-separated browser origins allowed by CORS and Socket.io (no wildcard fallback)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Requests allowed per IP every 15 minutes (default 1000)
RATE_LIMIT_MAX=

# --- Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=false                    # true only for managed DBs that require SSL
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# --- Redis (sessions + rate limiting). Leave REDIS_HOST empty to use in-memory ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# --- Secrets: generate with `openssl rand -base64 48` (see DEPLOY.md) ---
JWT_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_SECRET=

# --- Auth / third party ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Paystack secret key (sk_test_... locally, sk_live_... in production)
PAYSTACK_SECRET_KEY=
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
INTERSWITCH_TERMINAL_ID=
BITGIFTY_API_URL=
GEMINI_API_KEY=
SENTRY_DSN=

# --- Email (RESEND_API_KEY is required: the server won't boot without it) ---
RESEND_API_KEY=
FROM_MAIL=
CONTACT_EMAIL_RECEPIENT=

# --- Production seed (yarn seed:prod): passwords must be 12+ chars ---
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Optional second (base) admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
